# Copy this file to .env and fill in your own values. Never commit .env.
PORT=3000
# MySQL connection: mysql://user:password@host:3306/database
DATABASE_URL=mysql://root:password@localhost:3306/mcha
# false for a local database, true for most hosted databases
DATABASE_SSL=false
JWT_SECRET=change-me-to-a-long-random-string
# How long a login lasts before the user must sign in again (e.g. 30m, 2h, 7d)
JWT_EXPIRES_IN=2h
